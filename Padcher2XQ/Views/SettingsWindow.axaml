<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Padcher2XQ.ViewModels"
        x:Class="Padcher2XQ.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        x:CompileBindings="False"
        Title="Settings"
        Width="480" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>
    <StackPanel Spacing="15" Margin="20">
        <TextBlock Text="Application Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <CheckBox Content="Use Dark Mode" IsChecked="{Binding IsDarkMode}"/>
        <StackPanel Spacing="5">
            <TextBlock Text="Path to asar executable:"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding AsarPath}" PlaceholderText="e.g. asar.exe or /usr/bin/asar" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="..." Width="40" Command="{Binding SelectAsarFileCommand}"/>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Path to xdelta3 executable:"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding XdeltaPath}" PlaceholderText="e.g. xdelta3.exe or /usr/bin/xdelta3" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="..." Width="40" Command="{Binding SelectXdeltaFileCommand}"/>
            </Grid>
        </StackPanel>
        <Separator Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="0,10"/>
        
        <TextBlock Text="RetroAchievements API Integration" FontWeight="SemiBold"/>
        
        <StackPanel Spacing="5">
            <TextBlock Text="RA Username:"/>
            <TextBox Text="{Binding RaUser}" PlaceholderText="Enter your RetroAchievements Username"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Web API Key:"/>
            <TextBox Text="{Binding RaApiKey}" PlaceholderText="Enter your Web API Key" PasswordChar="•"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Close" IsDefault="True" Width="80" HorizontalContentAlignment="Center" Click="OnCloseClick"/>
        </StackPanel>
    </StackPanel>
</Window>