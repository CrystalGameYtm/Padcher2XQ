<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Padcher2XQ.ViewModels"
        x:Class="Padcher2XQ.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings — Padcher2XQ"
        Width="480" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SystemRegionBrush}">

    <DockPanel Margin="16">
        
        <!-- Нижня кнопка закриття -->
        <StackPanel DockPanel.Dock="Bottom" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,16,0,0">
            <Button Content="Done" 
                    Classes="ApplyAction" 
                    Click="CloseButton_Click" 
                    Width="100" 
                    HorizontalContentAlignment="Center"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

                <!-- 1. ТЕМА ОФОРМЛЕННЯ -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="APPEARANCE" Classes="SectionHeader"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="Dark Mode Theme" VerticalAlignment="Center" FontSize="13"/>
                            <ToggleSwitch Grid.Column="1" 
                                          IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                                          OnContent="Dark" 
                                          OffContent="Light" 
                                          FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. ЗОВНІШНІ ІНСТРУМЕНТИ (ASAR ТА XDELTA3) -->
                <Border Classes="Card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="EXTERNAL EXECUTABLES" Classes="SectionHeader"/>
                        
                        <!-- Asar Path -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Asar Executable Path" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0" 
                                         Text="{Binding AsarPath}" 
                                         PlaceholderText="Path to asar binary..." 
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center"
                                         CornerRadius="6,0,0,6"/>
                                <Button Grid.Column="1" 
                                        Content="Browse..." 
                                        Command="{Binding SelectAsarFileCommand}" 
                                        CornerRadius="0,6,6,0"
                                        Padding="12,0" 
                                        Height="32" 
                                        VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Xdelta3 Path -->
                        <StackPanel Spacing="4" Margin="0,4,0,0">
                            <TextBlock Text="Xdelta3 Executable Path" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0" 
                                         Text="{Binding XdeltaPath}" 
                                         PlaceholderText="Path to xdelta binary..." 
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center"
                                         CornerRadius="6,0,0,6"/>
                                <Button Grid.Column="1" 
                                        Content="Browse..." 
                                        Command="{Binding SelectXdeltaFileCommand}" 
                                        CornerRadius="0,6,6,0"
                                        Padding="12,0" 
                                        Height="32" 
                                        VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. RETROACHIEVEMENTS ІНТЕГРАЦІЯ -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="RETROACHIEVEMENTS CREDENTIALS" Classes="SectionHeader"/>
                        
                        <!-- User Name -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Username" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <TextBox Text="{Binding RaUser, Mode=TwoWay}" 
                                     PlaceholderText="RA Username..." 
                                     CornerRadius="6"/>
                        </StackPanel>

                        <!-- API Key -->
                        <StackPanel Spacing="4" Margin="0,4,0,0">
                            <TextBlock Text="Web API Key" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <TextBox Text="{Binding RaApiKey, Mode=TwoWay}" 
                                     PasswordChar="•" 
                                     PlaceholderText="RA API Key..." 
                                     CornerRadius="6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>