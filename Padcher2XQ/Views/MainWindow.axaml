<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Padcher2XQ.ViewModels"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
        x:Class="Padcher2XQ.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="False"
        Title="Padcher2XQ"
        Width="900" Height="540" CanResize="False"
        WindowStartupLocation="CenterScreen"
        >

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    
    <Grid Background="Transparent" DragDrop.AllowDrop="True">
        <DockPanel Margin="16">
            <StackPanel Spacing="10">
                
                <TextBlock Text="ROM File" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding RomPath}" PlaceholderText="Select a ROM to patch..." VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="..." Width="40" Command="{Binding SelectRomFileCommand}" ToolTip.Tip="Browse for ROM file"/>
                </Grid>

                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="Patch File(s)" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <CheckBox Content="MultiPatch Mode" IsChecked="{Binding IsMultiPatchMode}" HorizontalAlignment="Right"/>
                </DockPanel>
                
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding PatchPathDisplay}" PlaceholderText="Select a patch file..." Margin="0,0,8,0" IsReadOnly="True" Focusable="False"/>
                    <Button Grid.Column="1" Content="..." Width="40" Command="{Binding SelectPatchFileCommand}" ToolTip.Tip="Browse for patch file(s)"/>
                </Grid>

                <TextBlock Text="Output File" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding OutputPath}" PlaceholderText="Save as..." VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="..." Width="40" Command="{Binding SelectOutputFileCommand}" ToolTip.Tip="Select output destination"/>
                </Grid>
                
               <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="12" 
                        Margin="0,12,0,0">
                    <StackPanel Spacing="10">
                        
                        <Grid ColumnDefinitions="*,*">
                            
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Original ROM" FontWeight="Bold" Foreground="Gray"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CRC32:" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OrigCrc32}" FontFamily="Consolas, Monospace"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MD5:" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OrigMd5}" FontFamily="Consolas, Monospace"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA-1:" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OrigSha1}" FontFamily="Consolas, Monospace"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Patched ROM" FontWeight="Bold" Foreground="DodgerBlue"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CRC32:" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PatchedCrc32}" FontFamily="Consolas, Monospace"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MD5:" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PatchedMd5}" FontFamily="Consolas, Monospace"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA-1:" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PatchedSha1}" FontFamily="Consolas, Monospace"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="0,5"/>

                        <DockPanel>
                            <TextBlock Text="RetroAchievements:" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding RaStatus}" Foreground="{Binding RaStatusColor}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>

                    </StackPanel>
                </Border>
           
                
<Button Content="Apply Patch" 
        Classes="accent"
        FontWeight="Bold" 
        Height="45" 
        Command="{Binding ApplyPatchCommand}" 
        HorizontalAlignment="Stretch" 
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        Margin="0,16,0,0"/>

<TextBlock Text="{Binding StatusMessage}" 
           Foreground="{Binding StatusMessageColor}"
           FontWeight="SemiBold"
           HorizontalAlignment="Center"
           TextWrapping="Wrap"
           Margin="0,12,0,0"/>
</StackPanel>
</DockPanel>

<Button Command="{Binding OpenSettingsCommand}"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,8,8,0"
        Width="40" Height="32"
        CornerRadius="16"
        Background="Transparent"
        ToolTip.Tip="Open Settings">
    <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Button>
</Grid>
</Window>