    <Window xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:vm="using:Padcher2XQ.ViewModels"
            mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="480"
            x:Class="Padcher2XQ.Views.MainWindow"
            x:DataType="vm:MainWindowViewModel"
            Title="Padcher"
            Width="520" Height="480" CanResize="False">

        <Design.DataContext>
            <vm:MainWindowViewModel/>
        </Design.DataContext>
        
        <!-- Використовуємо Grid як основний контейнер, щоб розмістити кнопку поверх всього -->
        <Grid>
            <!-- Основний контент програми -->
            <DockPanel Margin="12">
                <StackPanel Spacing="8">
                    <!-- Секція ROM файлу -->
                    <TextBlock Text="ROM File" FontWeight="Bold"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBox Grid.Column="0" Text="{Binding RomPath, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="..." Width="40" Command="{Binding SelectRomFileCommand}"/>
                    </Grid>

                    <!-- Секція файлу патча -->
                    <DockPanel>
                        <TextBlock Text="Patch File" FontWeight="Bold" IsEnabled="{Binding !IsMultiPatchMode}" DockPanel.Dock="Left"/>
                        <CheckBox Content="MultiPatch" IsChecked="{Binding IsMultiPatchMode, Mode=TwoWay}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBox Grid.Column="0" Text="{Binding PatchPath, Mode=TwoWay}" VerticalAlignment="Center" IsEnabled="{Binding !IsMultiPatchMode}"/>
                        <Button Grid.Column="1" Content="..." Width="40" Command="{Binding SelectPatchFileCommand}" IsEnabled="{Binding !IsMultiPatchMode}"/>
                    </Grid>

                    <!-- Секція вихідного файлу -->
                    <TextBlock Text="Output File (New)" FontWeight="Bold" IsEnabled="{Binding !IsMultiPatchMode}"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBox Grid.Column="0" Text="{Binding OutputPath, Mode=TwoWay}" VerticalAlignment="Center" IsEnabled="{Binding !IsMultiPatchMode}"/>
                        <Button Grid.Column="1" Content="..." Width="40" Command="{Binding SelectOutputFileCommand}" IsEnabled="{Binding !IsMultiPatchMode}"/>
                    </Grid>
                    
                    <!-- Галочка "Ігнорувати контрольні суми" -->
                    <CheckBox Content="Ignore Checksums" IsChecked="{Binding IgnoreChecksums, Mode=TwoWay}" IsEnabled="{Binding !IsMultiPatchMode}" Margin="0,4,0,8"/>
                    
                    <!-- Інформація про файл -->
                    <HeaderedContentControl Header="{Binding FileInfoGroupName}" Padding="10">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="CRC32:" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Crc32}" FontFamily="monospace"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="MD5:" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Md5}" FontFamily="monospace"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA-1:" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Sha1}" FontFamily="monospace"/>
                        </Grid>
                    </HeaderedContentControl>
                    
                    <!-- Головні кнопки -->
                    <Grid ColumnDefinitions="*,*" Margin="0,16,0,0">
                        <Button Grid.Column="0" Content="Open MultiPatch" Height="40" IsEnabled="{Binding IsMultiPatchMode}" HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                        <Button Grid.Column="1" Content="Apply Patch" FontWeight="Bold" Height="40" Command="{Binding ApplyPatchCommand}" IsEnabled="{Binding !IsMultiPatchMode}" HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                    </Grid>

                    <!-- Текстовий блок для статусу -->
                    <TextBlock Text="{Binding StatusMessage}" 
                               Foreground="{Binding StatusMessageColor}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Кнопка налаштувань поверх всього у верхньому правому куті -->
            <Button Command="{Binding OpenSettingsCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,5,5,0"
                    Width="30" Height="30">
                <Button.Styles>
                    <!-- Стилі, щоб зробити кнопку круглою і прозорою -->
                    <Style Selector="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#20000000"/>
                    </Style>
                </Button.Styles>
                
                <!-- Іконка-шестерня (символ Unicode) -->
                <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>
    </Window>