<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Padcher2XQ.ViewModels"
        x:Class="Padcher2XQ.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Padcher2XQ"
        Width="580" Height="760"
        MinWidth="520" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SystemRegionBrush}">

    <Grid RowDefinitions="Auto, Auto, *, Auto, Auto" 
          Margin="16" 
          Background="Transparent"
          DragDrop.AllowDrop="True" 
          DragDrop.Drop="Window_Drop">

        <!-- 0. UpperBar -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Padcher2XQ" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="v2.2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </Border>
            </StackPanel>

            <Button Grid.Column="1" 
                    Content="⚙ Settings" 
                    Command="{Binding OpenSettingsCommand}"
                    Classes="IconButton"
                    Padding="10,6"
                    FontSize="12"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- 1. ROM FILE -->
        <Border Grid.Row="1" Classes="Card">
            <StackPanel Spacing="6">
                <TextBlock Text="ROM FILE" Classes="SectionHeader" />
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" 
                             Text="{Binding RomPath}" 
                             PlaceholderText="Select or drop a ROM file here..." 
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             CornerRadius="6,0,0,6" />
                    <Button Grid.Column="1" 
                            Content="Browse..." 
                            Command="{Binding SelectRomFile}" 
                            CornerRadius="0,6,6,0"
                            Padding="12,0" 
                            Height="32" 
                            VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. PATCHES (SINGLE / MULTI-PATCH) -->
        <Border Grid.Row="2" Classes="Card" Margin="0,0,0,10">
            <Grid RowDefinitions="Auto, *, Auto">
                
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                    <TextBlock Text="PATCH SETUP" Classes="SectionHeader" Margin="0" VerticalAlignment="Center"/>
                    
                    <ToggleSwitch Grid.Column="1" 
                                  IsChecked="{Binding IsMultiPatchMode}" 
                                  OnContent="Multi-Patch" 
                                  OffContent="Single Patch" 
                                  FontSize="12" />
                </Grid>

                <!-- Singlepatch -->
                <Grid Grid.Row="1" 
                      ColumnDefinitions="*, Auto" 
                      VerticalAlignment="Top" 
                      IsVisible="{Binding !IsMultiPatchMode}">
                    <TextBox Grid.Column="0" 
                             Text="{Binding PatchPath}" 
                             PlaceholderText="Select or drop patch (.bps, .ips, .ups, .xdelta)..." 
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             CornerRadius="6,0,0,6" />
                    <Button Grid.Column="1" 
                            Content="Browse..." 
                            Command="{Binding SelectPatchFile}" 
                            CornerRadius="0,6,6,0"
                            Padding="12,0" 
                            Height="32" 
                            VerticalContentAlignment="Center"/>
                </Grid>

                <!-- Multipatch List -->
                <Grid Grid.Row="1" RowDefinitions="*, Auto" IsVisible="{Binding IsMultiPatchMode}">
                    <Border Grid.Row="0" 
                            Background="{DynamicResource SystemControlBackgroundAltMediumHighBrush}" 
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ListBox ItemsSource="{Binding SelectedPatches}" 
                                     Background="Transparent" 
                                     Padding="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:PatchItemViewModel">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" 
                                              Margin="2,3"
                                              Background="Transparent"
                                              PointerPressed="Item_PointerPressed"
                                              PointerMoved="Item_PointerMoved"
                                              PointerReleased="Item_PointerReleased">
                                            
                                            <CheckBox Grid.Column="0" 
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}" 
                                                      VerticalAlignment="Center" 
                                                      Margin="0,0,8,0"/>
                                            
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding PatchName}" 
                                                       VerticalAlignment="Center" 
                                                       FontWeight="Medium" 
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            
                                            <Border Grid.Column="2" 
                                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" 
                                                    CornerRadius="4" 
                                                    Padding="6,2" 
                                                    Margin="8,0" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Format}" 
                                                           FontSize="10" 
                                                           FontWeight="Bold" 
                                                           Foreground="{DynamicResource SystemAccentColor}"/>
                                            </Border>
                                            
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                                <Button Content="▲" 
                                                        Classes="IconButton"
                                                        Command="{Binding $parent[Window].DataContext.MovePatchUpCommand}" 
                                                        CommandParameter="{Binding}" 
                                                        ToolTip.Tip="Move Up"/>
                                                <Button Content="▼" 
                                                        Classes="IconButton"
                                                        Command="{Binding $parent[Window].DataContext.MovePatchDownCommand}" 
                                                        CommandParameter="{Binding}" 
                                                        ToolTip.Tip="Move Down"/>
                                                <Button Content="✕" 
                                                        Classes="IconButton"
                                                        Command="{Binding $parent[Window].DataContext.RemovePatchCommand}" 
                                                        CommandParameter="{Binding}" 
                                                        Foreground="IndianRed" 
                                                        ToolTip.Tip="Remove"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>

                    <!-- Multipatch Panel -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,8,0,0">
                        <Button Grid.Column="0" 
                                Content="+ Add Patches..." 
                                Command="{Binding SelectPatchFile}" 
                                Padding="10,5" 
                                FontSize="12" />
                        
                        <Button Grid.Column="2" 
                                Content="Save Preset" 
                                Click="SavePreset_Click" 
                                Padding="8,5" 
                                FontSize="12" 
                                Margin="0,0,6,0"/>
                                
                        <Button Grid.Column="3" 
                                Content="Load Preset" 
                                Click="LoadPreset_Click" 
                                Padding="8,5" 
                                FontSize="12"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. OUTPUT & HASHSUM -->
        <StackPanel Grid.Row="3" Spacing="10">
            <Border Classes="Card" Padding="12" Margin="0">
                <StackPanel Spacing="6">
                    <TextBlock Text="OUTPUT FILE" Classes="SectionHeader" />
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" 
                                 Text="{Binding OutputPath}" 
                                 PlaceholderText="Auto-generated output file path..." 
                                 VerticalContentAlignment="Center"
                                 CornerRadius="6,0,0,6" />
                        <Button Grid.Column="1" 
                                Content="Save As..." 
                                Command="{Binding SelectOutputFile}" 
                                CornerRadius="0,6,6,0"
                                Padding="12,0" 
                                Height="32" 
                                VerticalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Expander -->
            <Expander Header="ROM Checksums &amp; Verification" 
                      IsExpanded="False" 
                      CornerRadius="8" 
                      Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                      BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <Grid ColumnDefinitions="*, 1, *" Margin="4,8">
                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                        <TextBlock Text="ORIGINAL ROM" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding OrigCrc32, StringFormat='CRC32: {0}'}" FontFamily="Monospace" FontSize="12"/>
                        <TextBlock Text="{Binding OrigMd5, StringFormat='MD5: {0}'}" FontFamily="Monospace" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OrigSha1, StringFormat='SHA1: {0}'}" FontFamily="Monospace" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Separator Grid.Column="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Width="1"/>

                    <StackPanel Grid.Column="2" Spacing="4" Margin="10,0,0,0">
                        <TextBlock Text="PATCHED ROM" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PatchedCrc32, StringFormat='CRC32: {0}'}" FontFamily="Monospace" FontSize="12"/>
                        <TextBlock Text="{Binding PatchedMd5, StringFormat='MD5: {0}'}" FontFamily="Monospace" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PatchedSha1, StringFormat='SHA1: {0}'}" FontFamily="Monospace" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                        
                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4" Padding="6,3" Margin="0,4,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding RaStatus, StringFormat='RA Status: {0}'}" 
                                       Foreground="{Binding RaStatusColor}" 
                                       FontSize="11" 
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Expander>
        </StackPanel>

        <!-- 4. PATCH BUTTON & STATUSBAR -->
        <Grid Grid.Row="4" RowDefinitions="Auto, Auto" Margin="0,12,0,0">
            <Button Grid.Row="0" 
                    Content="Apply Patch(es)" 
                    Command="{Binding ApplyPatchCommand}" 
                    Classes="ApplyAction" 
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center"
                    Height="42" />

            <TextBlock Grid.Row="1" 
                       Text="{Binding StatusMessage}" 
                       Foreground="{Binding RaStatusColor}" 
                       FontSize="12" 
                       FontWeight="Medium" 
                       Margin="2,8,2,0" 
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Grid>
</Window>