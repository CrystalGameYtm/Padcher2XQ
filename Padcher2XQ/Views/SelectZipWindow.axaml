<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Padcher2XQ.ViewModels"
        x:Class="Padcher2XQ.Views.SelectZipWindow"
        x:DataType="vm:SelectZipViewModel"
        Title="Select Patch from Archive"
        Width="400" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Multiple patches found in the archive. Please select one:" 
                   TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="SemiBold"/>
        
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Cancel" Click="CancelButton_Click" Width="80" HorizontalContentAlignment="Center"/>
            <Button Content="Extract" Classes="accent" Click="SelectButton_Click" Width="80" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" CornerRadius="4">
            <ListBox ItemsSource="{Binding Entries}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding FileName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>