<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Padcher2XQ.ViewModels"
        x:Class="Padcher2XQ.Views.SelectZipWindow"
        x:DataType="vm:SelectZipViewModel"
        Title="Select Patch from Archive"
        Width="420" Height="320"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" 
                   Text="Multiple patches found in the archive. Please select:" 
                   TextWrapping="Wrap" 
                   Margin="0,0,0,10" 
                   FontWeight="SemiBold"/>
        
        <StackPanel DockPanel.Dock="Bottom" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Spacing="10" 
                    Margin="0,10,0,0">
            <Button Content="Cancel" Click="CancelButton_Click" Width="80" HorizontalContentAlignment="Center"/>
            <Button Content="Extract" Classes="accent" Click="SelectButton_Click" Width="80" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                BorderThickness="1" 
                CornerRadius="4">
            <Grid>
                <!-- SinglePatch Mode -->
                <ListBox ItemsSource="{Binding SingleEntries}" 
                         IsVisible="{Binding !IsMultiMode}"
                         Background="Transparent" 
                         Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SingleZipItem">
                            <RadioButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Content="{Binding FileName}"
                                         GroupName="SingleZipGroup"
                                         VerticalAlignment="Center"
                                         Margin="2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Multipatch Mode -->
                <ListBox ItemsSource="{Binding MultiEntries}" 
                         IsVisible="{Binding IsMultiMode}"
                         Background="Transparent" 
                         Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MultiZipItem">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Content="{Binding FileName}"
                                      VerticalAlignment="Center"
                                      Margin="2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</Window>